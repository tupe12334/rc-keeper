{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "changelog-path": "CHANGELOG.md",
  "packages": {
    ".": {
      "extra-files": [
        { "type": "json", "path": "src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/rc-core/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/rc-ipc/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/rc-cli/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "json", "path": "ui/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
