{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main rc-keeper window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://claude.ai/*" },
        { "url": "https://code.claude.com/*" },
        { "url": "https://github.com/tupe12334/rc-keeper/blob/main/*" }
      ]
    }
  ]
}
